function module.btween(part, maxSize, trans, times, color, cf)
	local Info = TweenInfo.new(
		times or 1,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out,
		0,
		false,
		0
	)
	local new = {}
	new.Size = maxSize
	new.Transparency = trans
	new.Color = color
	new.CFrame = cf
	local twee = TS:Create(part, Info, new)
	twee:Play()
	return twee
end

