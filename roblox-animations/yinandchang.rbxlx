						<string name="ScriptGuid">{5E1EDB13-2236-4527-B6FA-A1E64279CA65}</string>
						<ProtectedString name="Source"><![CDATA[-- Services
local Players = game:GetService('Players')
local RunService = game:GetService('RunService')

-- Mouse
local Mouse = Players.LocalPlayer:GetMouse()

local Module = { }
Module.Connections = { }

Module.Init = function( PrimaryPart )
	if #Module.Connections >= 1 then return end
	
	-- Lock player in place
	local LockPart = Instance.new('Part')
	LockPart.Name = 'RotationPart'
	LockPart.Position = PrimaryPart.Position
	LockPart.Transparency = 1
	LockPart.Anchored = true
	LockPart.CanCollide = false
	LockPart.Parent = PrimaryPart

	-- Attachments
	local Attachment0 = Instance.new('Attachment')
	Attachment0.Name = 'PrimaryPartAttachment'
	Attachment0.Parent = PrimaryPart

	local Attachment1 = Instance.new('Attachment')
	Attachment1.Parent = LockPart

	-- AlignPosition
	local AlignPosition = Instance.new('AlignPosition')
	AlignPosition.ApplyAtCenterOfMass = true
	AlignPosition.ReactionForceEnabled = true
	AlignPosition.MaxForce = math.huge
	AlignPosition.Responsiveness = 200
	AlignPosition.Attachment0 = Attachment0
	AlignPosition.Attachment1 = Attachment1
	AlignPosition.Parent = LockPart

	-- AlignOrientation
	local AlignOrientation = Instance.new('AlignOrientation')
	AlignOrientation.MaxTorque = math.huge
	AlignOrientation.Responsiveness = 200
	AlignOrientation.Attachment0 = Attachment0
	AlignOrientation.Attachment1 = Attachment1
	AlignOrientation.Parent = LockPart

	Module.Connections[#Module.Connections + 1] = RunService.RenderStepped:Connect(function()
		LockPart.CFrame = CFrame.lookAt(LockPart.CFrame.Position, Vector3.new(Mouse.Hit.Position.X, 0, Mouse.Hit.Position.Z))
	end)
end

Module.Deinit = function(PrimaryPart)
	
	-- Destroy the rotation part and the primary part attachment utilized by the align constraints.
	PrimaryPart:FindFirstChild('RotationPart'):Destroy()
	PrimaryPart:FindFirstChild('PrimaryPartAttachment'):Destroy()
	
	for _, v in ipairs( Module.Connections )  do
		v:Disconnect()
	end
	Module.Connections = { }
end

return Module]]></ProtectedString>
