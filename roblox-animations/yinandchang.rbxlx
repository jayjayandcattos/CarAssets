							<string name="ScriptGuid">{F3F9FF1D-78DB-40AC-91D8-E3DAB0A143DE}</string>
							<ProtectedString name="Source"><![CDATA[-- Services
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")

-- Instances
local modules = ReplicatedStorage.Modules.FXModules
local effectModules = modules.Effects
local skillAssets = ReplicatedStorage.Assets
local mesheffects = skillAssets.MeshEffects
local particles = skillAssets.Particles.Yinlin
local sound = skillAssets.Sounds
local Animations = skillAssets.Animations.Yinlin

local spawnedObjects = workspace.SpawnedObjects
--
local BezierModule = require(modules.BezierCurve)
local VFXHelp = require(effectModules.VFXHelp)
local RockModule = require(effectModules.RockModule)
local StopwatchCreator = require(modules.StopwatchCreator)
local CustomWait = require(modules.CustomWait)
local AnimHelper = require(modules.AnimationHelper)
local Utility = require(modules.Utility)
local BezierCurve = require(script.BezierCurve)

local SharedModules = {}
for i,v in pairs(effectModules:GetChildren()) do
	if v:IsA('ModuleScript') and v.Name~= script.Name then
		SharedModules[v.Name] = require(v)
	end
end

local function CubicCurve(a,b,t)
	return a + (b-a) * t
end

return function( Data )
	local Root:Part = Data.root
	local Character = Data.char
	local hitcframe = Root.CFrame * CFrame.new(0,0,-15)
	--local Info = {,math.random(-40,40),math.random(10,40),math.random(-40,40),,math.random(-20,20),math.random(8,17),math.random(-20,20)}
	
	Root.Anchored = true
	
	local function move(ring)
		local c = ring:Clone()
		c.CFrame = ring.CFrame
		c.CastShadow = false
		c.Parent = spawnedObjects
		c.Transparency = 0
		c.Size = Vector3.zero

		local c2 = ring:Clone()
		c2.CFrame = ring.CFrame
		c2.CastShadow = false
		c2.Parent = spawnedObjects
		c2.Material = Enum.Material.Neon
		c2.Size = Vector3.zero
		c2.Color = Color3.fromRGB(255, 255, 255)

		TweenService:Create(c2, TweenInfo.new(.2), {Color = Color3.fromRGB(145, 13, 188)}):Play()
		TweenService:Create(c, TweenInfo.new(.3), {Size = Vector3.new(0.51, 0.949, 2.2)}):Play()
		TweenService:Create(c2, TweenInfo.new(.1), {Size = Vector3.new(0.5, 0.949, 2.3)}):Play()

		if ring:GetAttribute("rotationa") == 1 then

			ring:SetAttribute("rotationa", 2)
			c.CFrame *= CFrame.Angles(0, 0, math.rad(90))
			c2.CFrame *= CFrame.Angles(0, 0, math.rad(90))

		else

			ring:SetAttribute("rotationa", 1)

		end

		task.delay(1.5,function()
			TweenService:Create(c2, TweenInfo.new(1), {Size = Vector3.zero}):Play()
			TweenService:Create(c, TweenInfo.new(1), {Size = Vector3.zero}):Play()
			task.wait(1.01)
			c:Destroy()
			c2:Destroy()
		end)
	end
	
	local MiddleOffset = {
		Min = {
			X = 5,
			Y = 5,
			Z = 5
		},
		Max = {
			X = 10,
			Y = 10,
			Z = 10
		}
	}

	local Params = {
		Duration = 0.25,
		EasingStyle = Enum.EasingStyle.Linear,
		EasingDirection = Enum.EasingDirection.InOut,
		LookAt = true
	}
	
	local function doSlash(rot:number,part:Part)
		local function createSingleSlash(frontBoost:number)
			local slashCF = part.CFrame*CFrame.new(0,0,-frontBoost)*CFrame.Angles(0,0,math.rad(rot))*CFrame.Angles(0,math.rad(90),0)

			VFXHelp.EmitAndRemove(particles.M1.SlashSlow,slashCF)
		end
		createSingleSlash(2)
	end

	
	local function createBezier(finalPart: BasePart, rootPart: BasePart) -- credit delian
		local start = rootPart.Position
		local goal = finalPart.Position

		local min, max = MiddleOffset.Min, MiddleOffset.Max
		local x = Utility.GetRandomNumber(min.X, max.X, true)
		x *= Utility.GetRandomSign()
		local y = Utility.GetRandomNumber(min.Y, max.Y, true)
		y *= Utility.GetRandomSign()
		local z = Utility.GetRandomNumber(min.Z, max.Z, true)
		z *= Utility.GetRandomSign()

		local alpha = Utility.GetRandomNumber(0.4, 0.6, true)
		local orientation = CFrame.Angles(CFrame.lookAt(rootPart.Position, goal):ToEulerAnglesXYZ())
		local middle = (CFrame.new(start:Lerp(goal, alpha)) * orientation) * CFrame.new(x, y, z)

		BezierCurve.Play(rootPart, {start, middle.Position, goal}, false, Params)

		rootPart.Transparency = 1
		Utility.DelayDestruction(0.5, rootPart)
	end
	
	local cor2 = particles.shockbig:Clone()
	cor2.Parent = spawnedObjects
	cor2.CFrame = hitcframe * CFrame.new(0,10,0)
	
	sound.Yinlin.chargeexplode:Play()

	for i = 1,15 do
		local trailPart = particles.trail:Clone()
		trailPart.Position = cor2.Position + Vector3.new(math.random(-35,35),math.random(-10,15),math.random(-35,35))
		trailPart.Parent = spawnedObjects

		createBezier(cor2, trailPart);
		task.wait(0.03)
	end	
	wait(0.2)
	VFXHelp.DisableVFX(cor2)
	Debris:AddItem(cor2,1)
	local track = AnimHelper.GetTrack(Character.Humanoid,Animations.E.AnimationId)
	track:Play()
	
	local Projectile = particles.Projectile:Clone()
	Projectile.Parent = spawnedObjects
	Projectile.CFrame = Root.CFrame * CFrame.new(0,0,10)
	
	local at0 = Instance.new("Attachment",Root)
	
	for i,v in pairs(Projectile.At1:GetDescendants()) do
		if v:IsA("Beam") then
			v.Attachment0 = at0
		end
	end
	
	local Start = Root.CFrame * CFrame.new(0,0,10).Position
	local Spot1 = (Start + (hitcframe * CFrame.new(math.random(-5,5),0,math.random(-10,10))).Position) / 2 + Vector3.new(0,math.random(20,25),0)
	local End = hitcframe.Position
	--
	doSlash(-90,Root)
	
	for	i = 0,1,0.04 do
		local A = CubicCurve(Start,Spot1,i)
		local B = CubicCurve(Spot1,End,i)
		--
		local Path = CubicCurve(A,B,i)
		--
		Projectile.Position = Path
		--
		task.wait()
		--
	end	
	
	for i,v in pairs(Projectile.At1:GetDescendants()) do
		if v:IsA("Beam") then
			TweenService:Create(v,TweenInfo.new(.3),{Width0 = 0,Width1 = 0}):Play()
		end
	end
	Debris:AddItem(Projectile,1)
	Debris:AddItem(at0,0.5)
	
	local target = VFXHelp.EmitAndRemove(particles.LockonTarget,hitcframe,{maxFloorDist = 10})
	local cor = particles.corrup:Clone()
	cor.Parent = spawnedObjects
	cor.CFrame = hitcframe
	
	for i = 1,18 do
		local trailPart = particles.trail:Clone()
		trailPart.Position = target.Position + Vector3.new(math.random(-15,15),math.random(0,10),math.random(-15,15))
		trailPart.Parent = spawnedObjects

		createBezier(target, trailPart);
		task.wait(0.03)
	end	
	VFXHelp.DisableVFX(cor)
	Debris:AddItem(cor,1)
	
	sound.Yinlin.explode:Play()
	
	local shard = particles.shard:Clone()
	shard.CFrame = hitcframe
	shard.Parent = spawnedObjects
	
	VFXHelp.EmitAndRemove(particles.explosion,hitcframe,{maxFloorDist = 10})
	
	Root.Anchored = false
	
	CollectionService:AddTag(Root,"Evolve")
	
	for i = 1,5 do
		task.spawn(function()
			for i = 1,2 do
				BezierModule.CubicCurve2(
					shard,
					(hitcframe * CFrame.new(math.random(-10,10),-2,math.random(-10,10))).Position,
					(hitcframe * CFrame.new(math.random(-35,35),math.random(15,25),math.random(-35,35))).Position,
					0.04,
					Vector3.new(math.random(-30,20),math.random(10,20),math.random(-40,40)),
					Vector3.new(math.random(-20,30),math.random(5,15),math.random(-10,30)),
					Vector3.new(math.random(-10,40),math.random(0,5),math.random(-20,40)),
					true,
					move,
					false,
					nil
				)
				wait(0.1)
			end
		end)
	end
	
	task.delay(10,function()
		CollectionService:RemoveTag(Root,"Evolve")
	end)
end]]></ProtectedString>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
							<UniqueId name="UniqueId">26961b75bcb08f59067dd29300005a66</UniqueId>
						</Properties>
						<Item class="ModuleScript" referent="RBXF95427F8A07A4299AED845B40DC2B334">
							<Properties>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">BezierCurve</string>
								<string name="ScriptGuid">{637145CA-C36B-4077-A267-6822D476D326}</string>
								<ProtectedString name="Source"><![CDATA[--// SERVICES
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

--// TYPES
type Point = Vector3 | BasePart
type Params = {
	Duration: number,
	EasingStyle: Enum.EasingStyle,
	EasingDirection: Enum.EasingDirection,
	LookAt: boolean,
	PointsInObjectSpace: boolean?
}

--// CONSTANTS
local EASING_STYLE = Enum.EasingStyle.Linear
local EASING_DIRECTION = Enum.EasingDirection.Out
local LOOK_AT = false
local POINTS_IN_OBJECT_SPACE = false

--// VARIABLES
local Module = {}

--// FUNCTIONS
local function lerp(startPoint: Point, endPoint: Point, alpha: number)
	if typeof(startPoint) == "Instance" then
		startPoint = startPoint.Position
	end
	if typeof(endPoint) == "Instance" then
		endPoint = endPoint.Position
	end
	return startPoint:Lerp(endPoint, alpha)
end

local function lerpPoints(points: {Point}, alpha: number)
	local lerps = {}
	local startPoint = points[1]
	local endPoint = points[2]
	for i = 2, #points do
		table.insert(lerps, lerp(startPoint, endPoint, alpha))
		startPoint = points[i]
		i += 1
		endPoint = points[i]
	end

	if #lerps == 1 then
		return lerps[1]
	else
		return lerpPoints(lerps, alpha)
	end
end

--// MODULE FUNCTIONS
function Module.Play(target: BasePart, points: {Point}, waitUntilCompleted: boolean, params: Params)
	local duration = params.Duration
	local style = params.EasingStyle or EASING_STYLE
	local direction = params.EasingDirection or EASING_DIRECTION
	local lookAt = params.LookAt or LOOK_AT
	local startTime = os.clock()

	local startCFrame
	local pointsInObjectSpace = params.PointsInObjectSpace or POINTS_IN_OBJECT_SPACE
	if pointsInObjectSpace then
		startCFrame = target.CFrame
	end

	local thread = coroutine.running()
	local heartbeat
	heartbeat = RunService.Heartbeat:Connect(function()
		local alpha = (os.clock() - startTime) / duration
		alpha = TweenService:GetValue(alpha, style, direction)
		if alpha >= 1 then
			heartbeat:Disconnect()
			alpha = 1

			local endPoint = points[#points]
			if typeof(endPoint) == "Instance" then
				endPoint = endPoint.Position
			end
			if pointsInObjectSpace then
				endPoint = startCFrame:PointToWorldSpace(endPoint)
			end
			
			if lookAt then
				local lookAtPosition = endPoint
				if typeof(lookAt) == "Instance" then
					lookAtPosition = lookAt.Position
				elseif typeof(lookAt) == "Vector3" then
					lookAtPosition = lookAt
				end

				local x, y, z = CFrame.lookAt(target.Position, lookAtPosition):ToOrientation()
				target.CFrame = CFrame.new(endPoint) * CFrame.fromOrientation(x, y, z)
			else
				target.Position = endPoint
			end

			if waitUntilCompleted then
				coroutine.resume(thread)
			end
		else
			local position = lerpPoints(points, alpha)
			if pointsInObjectSpace then
				position = startCFrame:PointToWorldSpace(position)
			end

			if lookAt then
				local lookAtPosition = position
				if typeof(lookAt) == "Instance" then
					lookAtPosition = lookAt.Position
				elseif typeof(lookAt) == "Vector3" then
					lookAtPosition = lookAt
				end

				local x, y, z = CFrame.lookAt(target.Position, lookAtPosition):ToOrientation()
				target.CFrame = CFrame.new(position) * CFrame.fromOrientation(x, y, z)
			else
				target.Position = position
			end
		end
	end)

	if waitUntilCompleted then
		coroutine.yield()
	end

	return heartbeat
end

return Module]]></ProtectedString>
