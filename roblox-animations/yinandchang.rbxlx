						<ProtectedString name="Source"><![CDATA[local AnimationHelper = {}

function AnimationHelper.GetTrack(humanoid:Humanoid,id:string):AnimationTrack
    local animation = Instance.new('Animation')
    animation.AnimationId = id
    local track = humanoid.Animator:LoadAnimation(animation)
    return track
end

return AnimationHelper
]]></ProtectedString>
