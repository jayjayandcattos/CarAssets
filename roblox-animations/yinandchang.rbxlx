					<ProtectedString name="Source"><![CDATA[local BasicSystems = {}

BasicSystems.RaycastParams = function(IgnoreList: {any}, Type: string)
	local RayParams = RaycastParams.new()
	RayParams.FilterType = Enum.RaycastFilterType[Type]
	RayParams.FilterDescendantsInstances = IgnoreList
	RayParams.IgnoreWater = true

	return RayParams
end

BasicSystems.GetPositionWithRaycastAndResult = function(origin: Vector3, direction: Vector3, Params: RaycastParams)
	local orign, direction = origin, direction
	local result = workspace:Raycast(orign, direction, Params)

	if result then
		return {["Result"] = result, ["Position"]  = result.Position}
	else
		return {["Result"] = false, ["Position"] = orign + direction}
	end
end

BasicSystems.GetPositionWithRaycast = function(origin: Vector3, direction: Vector3, Params: RaycastParams)
	local Origin, Direction = origin, direction
	local result = workspace:Raycast(Origin, Direction, Params)
	return result and result.Position or Origin + Direction
end

BasicSystems.GetDistance = function(X: Vector3, Y:Vector3)
	return (X - Y).Magnitude
end

return BasicSystems
]]></ProtectedString>
