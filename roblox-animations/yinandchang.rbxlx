		<Item class="LocalScript" referent="RBX976D71952A9A4EE99B6D3C6C11CAA5B6">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LocalScript</string>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{45973012-6CAF-4F66-AFF0-065887FF7226}</string>
				<ProtectedString name="Source"><![CDATA[local UIS = game:GetService("UserInputService")
local Mouse = game.Players.LocalPlayer:GetMouse()
Mouse.TargetFilter = game.Workspace.SpawnedObjects
local Char = game.Players.LocalPlayer.Character
local RS = game:GetService("ReplicatedStorage")
local Remote = RS.Remotes
local bool = script.Evolve

local CD = 1
local KeyDown = false
--
UIS.InputBegan:Connect(function(Key,IsTyping)
	if IsTyping then return end
	if Key.KeyCode == Enum.KeyCode.Z and KeyDown == false then
		KeyDown = true
		Remote.Active:FireServer("Y E-Skill")
		wait(CD)
		KeyDown = false	
		bool.Value = true

		task.delay(10,function()
			bool.Value = false
		end)
		
	elseif Key.KeyCode == Enum.KeyCode.X and KeyDown == false then
		KeyDown = true
		Remote.Active:FireServer("Y M1-String",bool.Value)
		wait(CD)
		KeyDown = false	
	elseif Key.KeyCode == Enum.KeyCode.C and KeyDown == false then
		KeyDown = true
		Remote.Active:FireServer("C M1-String")
		wait(CD)
		KeyDown = false	
	elseif Key.KeyCode == Enum.KeyCode.V and KeyDown == false then
		KeyDown = true
		Remote.Active:FireServer("C E-Skill")
		wait(CD)
		KeyDown = false	
	end
end)]]></ProtectedString>
				<int64 name="SourceAssetId">-1</int64>
