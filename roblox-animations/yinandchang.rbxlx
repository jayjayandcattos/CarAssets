					<string name="ScriptGuid">{9CB22E11-12CA-48BF-BB52-06B051832442}</string>
					<ProtectedString name="Source"><![CDATA[-- Services
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local CC = game:GetService("CollectionService")
--
local Remote = ReplicatedStorage.Remotes.Active
local Replicator = ReplicatedStorage.Remotes.FX
--
local bezierCurve = require(ReplicatedStorage.Modules.FXModules.BezierCurve)
local AnimHelper = require(ReplicatedStorage.Modules.FXModules.AnimationHelper)

Remote.OnServerEvent:Connect(function(plr,action:string,bool:boolean)
	--
	local Character = plr.Character
	local RootPart:Part = Character.HumanoidRootPart
	local Humanoid:Humanoid = Character.Humanoid	
	--
	local OriginCF = RootPart.CFrame

	if action == "Y E-Skill" then
		Replicator:FireAllClients('Y E-Skill',{root = RootPart,char = Character})
	elseif action == "Y M1-String" then
		if bool == true then
			Replicator:FireAllClients('Y M1-String',{root = RootPart,char = Character,Count = 2})
		else
			Replicator:FireAllClients('Y M1-String',{root = RootPart,char = Character,Count = 0})
		end
	elseif action == "C M1-String" then
		Replicator:FireAllClients('C M1-String',{root = RootPart,char = Character})
	elseif action == "C E-Skill" then
		Replicator:FireAllClients('C E-Skill',{root = RootPart,char = Character})
	end
end)]]></ProtectedString>
