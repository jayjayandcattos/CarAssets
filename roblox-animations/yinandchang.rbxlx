					<ProtectedString name="Source"><![CDATA[-- Services
local Replicated = game:GetService('ReplicatedStorage')

local TweenService = game:GetService('TweenService')
local RunService = game:GetService('RunService')
local Debris = game:GetService('Debris')

-- Assets
local Assets = Replicated.Assets

local Particles = Assets.Particles
local Remote = Replicated.Remotes.FX

-- Datatypes
local ChargeInfo = TweenInfo.new(0.055, Enum.EasingStyle.Linear, Enum.EasingDirection.In)

-- Auxiliary
Remote.OnClientEvent:Connect(function(Module, ...)
	--
	for _, v in ipairs( Replicated.Modules.Visuals:GetDescendants() ) do
		if v:IsA('ModuleScript') and v.Name == Module then
			require(v)(...)
		end
	end
end)]]></ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
