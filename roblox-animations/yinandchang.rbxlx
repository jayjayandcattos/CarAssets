		<Item class="Script" referent="RBX5DFF24E381C24F80A9FB93F5AC0A88FC">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<bool name="Disabled">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">MouseHandler</string>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{1B6F1735-AEC6-41BF-894E-B20B22080BD9}</string>
				<ProtectedString name="Source"><![CDATA[--—————— Services

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

--—————— BridgeNet

local BridgeNet = require(ReplicatedStorage.Modules.BridgeNet2)
local Server = BridgeNet.ServerBridge("MousePosition")

--—————— Connections

Players.PlayerAdded:Connect(function(Player: Player)
	
	local Value = Instance.new("Vector3Value")
	Value.Name = Player.Name.."Mouse"
	Value.Parent = ReplicatedStorage.PlayerInfo.MousePositions
	
end)

Players.PlayerRemoving:Connect(function(Player: Player)
	
	local Value = ReplicatedStorage.PlayerInfo.MousePositions:FindFirstChild(Player.Name.."Mouse")
	if Value then
		
		Value:Destroy()
		
	end
	
end)

Server:Connect(function(Player: Player, MousePosition: Vector3)
	
	ReplicatedStorage.PlayerInfo.MousePositions[Player.Name.."Mouse"].Value = MousePosition
	
end)]]></ProtectedString>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<UniqueId name="UniqueId">4281476f17be2161063e9167000081d5</UniqueId>
			</Properties>
		</Item>
	</Item>
