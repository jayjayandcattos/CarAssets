				</Properties>
			</Item>
			<Item class="Script" referent="RBX2FC5376AB99444599535FFA96805FF1E">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<bool name="Disabled">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AutoRotateToMouse</string>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{CE650014-A564-4870-ABD4-52EE4C5F1841}</string>
					<ProtectedString name="Source"><![CDATA[local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = game.Workspace.CurrentCamera

local function getMousePosition()
    local mouseLocation = UserInputService:GetMouseLocation()
    local unitRay = Camera:ScreenPointToRay(mouseLocation.X, mouseLocation.Y)
    local ray = Ray.new(unitRay.Origin, unitRay.Direction * 1000)
    local _, position = workspace:FindPartOnRay(ray, LocalPlayer.Character)
    return position
end

local function rotateCharacterToMousePosition()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    character:WaitForChild("HumanoidRootPart") -- Ensure the HumanoidRootPart is loaded

    while true do
        task.wait() -- It's better to use task.wait() for performance reasons
        local mousePosition = getMousePosition()
        if mousePosition then
            local characterPosition = character.HumanoidRootPart.Position
            local direction = (mousePosition - characterPosition).unit
            local newCFrame = CFrame.lookAt(characterPosition, characterPosition + direction)
            character:SetPrimaryPartCFrame(newCFrame)
        end
    end
end

rotateCharacterToMousePosition()]]></ProtectedString>
