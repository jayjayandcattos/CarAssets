					<Item class="ModuleScript" referent="RBXC30C2011AA794C0E9F214198C4FA7745">
						<Properties>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BezierModule</string>
							<string name="ScriptGuid">{47A21A55-8329-45F9-A27B-898C3D2570E5}</string>
							<ProtectedString name="Source"><![CDATA[--[[
	-	MODULE MADE BY KYRUSHUI	 -
	
	Firstly, this module uses the Signal module not owned by me, but the rest is all my work.
	
	USAGE:
		local function myFunc(point)
			print(point)
		end
		Bezier = BezierModule.new(Vector3.new(0,0,0), Vector3.new(0,0,10)) -- The two variables here should only be the Start and End point
		Bezier:CreatePoint(-10,10,Bezier.GetDistance()/2)
		Bezier:Play(myFunc)
		
	FUNCTIONS:
		This includes a few things handy to you. You have a get distance function to easily get the distance rather than calculating it yourself.
		
		to use it just simply:
			bezier = BezierModule.new(Start, Finish)
			bezier:GetDistance()
			
		The next function is a singal called the completed signal. To use:
			
			bezier = BezierModule.new(Start,Finish)
			bezier.Play()
			bezier.Completed:Connect(function()
				print('Completed!')
			end)
		If you only want a specific point in a bezier curve simply use:
			
			bezier = BezierModule.new(Start,Finish)
			bezier:Get(0.5) -- This would get you the mid part of a bezier
			
		To get the midpoint:
			bezier = BezierModule.new(Start,Finish)
			bezier:GenerateMidpoint() -- This would auto get the midpoint
			
	

]]



local function quadBezier(t, p0, p1, p2)
	return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end


local RS = game:GetService('RunService')


local Signal = require(script:WaitForChild('Assets').Signal)
 
return {
	new = function(Points)
		local self = setmetatable({},{__index = {}})
		
		self.Points = Points
		self.Parent = workspace
		self.Speed = 50
		
		
		self.Completed = Signal:Create()
		local PointCount = 1
		local Start = Points[1]
		local End = Points[#Points]
		
		local function lerp(a, b, c)
			return a + (b - a) * c
		end
		local function GenerateBezier(ratio)
			if #self.Points == 3 then
				return quadBezier(ratio,Start,self.Points[2],End)
			else
				local Orbit = {}
				for i = 1, #self.Points-1 do

					Orbit[#Orbit + 1] = lerp(self.Points[i], self.Points[i + 1],ratio)
				end

				while #Orbit> 1 do
					local Hold = {}
					for i = 1, #Orbit-1 do
						Hold[#Hold + 1] = lerp(Orbit[i], Orbit[i + 1],ratio)
					end
					Orbit = Hold
					RS.Heartbeat:Wait()
				end
				return Orbit[1]
			end
			
		end
		
		function self:CreatePoint(Offset)
			local Midpoint
			local Point = Instance.new('Part',self.Parent)
			Point.Name = 'Point_'..PointCount
			PointCount += 1
			if self.Debug then
				Point.Transparency = 0
			else
				Point.Transparency = 1
			end
			Point.Size = Vector3.new(1,1,1)
			Point.Anchored = true
			Point.CanCollide = false
			Point.Material = Enum.Material.Neon
			
			Midpoint = self:GenerateMidpoint()
			Point.Position = Midpoint
			Point.CFrame = CFrame.new(Midpoint,Start) * Offset
			
			table.remove(self.Points,#self.Points)
			table.insert(self.Points, Point.Position)
			table.insert(self.Points, End)
			
			Point:Destroy()
		end
		
		function self:GenerateMidpoint(Offset)
			local Midpoint = (Start + End) / 2
			return Midpoint
		end
		function self:GetDistance()
			return (End - Start).Magnitude
		end
		
		function self:Get(ratio)
			return GenerateBezier(ratio)
		end
		function self:Play(Function)
			local i = 0
			local Listener;Listener = RS.Heartbeat:Connect(function(step)
				i += step/self:GetDistance() * self.Speed
				if Function then
					Function(self:Get(i))
				else
					warn('Bezier Curve Module: No Function was given!')
				end
				
				if i >= 1 then
					Listener:Disconnect()
					return self.Completed:Fire()
				end
			end)
		end
		return self
	end;
}

]]></ProtectedString>
