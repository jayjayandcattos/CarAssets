	Root.Anchored = true
	
	local Ori = Root.CFrame * CFrame.new(0,0,15)
	
	for i = 1,5 do
		Root.CFrame = Root.CFrame * CFrame.new(0,4,0)
		
		local Slashtip = particles.SlashTip:Clone()
		Slashtip.Parent = spawnedObjects
		Slashtip.CFrame = Ori * CFrame.new(math.random(-10,10),math.random(3,15),math.random(-25,-10)) * CFrame.Angles(math.rad(math.random(50,70)),0,math.rad(math.random(-90,90)))
		local Slashtip1 = particles.SlashTip:Clone()
		Slashtip1.Parent = spawnedObjects
		Slashtip1.CFrame = Ori * CFrame.new(math.random(-10,10),math.random(3,15),math.random(-25,-10)) * CFrame.Angles(math.rad(math.random(-70,-50)),0,math.rad(math.random(-90,90)))
