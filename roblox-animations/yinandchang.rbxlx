						<UniqueId name="UniqueId">66cad98e8b9b172d0612e65600005f03</UniqueId>
					</Properties>
					<Item class="ModuleScript" referent="RBX82FE0967E1784A4E95AB23EB72B89DF2">
						<Properties>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
