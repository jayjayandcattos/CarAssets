		trailb.Parent = spawnedObjects
		trailb.CFrame = Slashtip.CFrame * CFrame.new(0,-25,0)
		local tween = TweenService:Create(trailb, TweenInfo.new(.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {CFrame = Slashtip.CFrame * CFrame.new(0,25,0)})
		tween:Play()
		tween.Completed:Connect(function()
			Debris:AddItem(trailb,1)
			VFXHelp.DisableVFX(trailb)
			VFXHelp.DisableVFX(Slashtip)
		end)
		local trailb1 = particles.trailbig:Clone()
