							<string name="ScriptGuid">{4BF16EFE-400B-484B-A618-8EDBD49432ED}</string>
							<ProtectedString name="Source"><![CDATA[-- Services
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ContextActionService = game:GetService("ContextActionService")

-- Instances
local modules = ReplicatedStorage.Modules.FXModules
local effectModules = modules.Effects
local skillAssets = ReplicatedStorage.Assets
local mesheffects = skillAssets.MeshEffects
local particles = skillAssets.Particles.Yinlin
local sound = skillAssets.Sounds
local Animations = skillAssets.Animations.Yinlin

local spawnedObjects = workspace.SpawnedObjects
--
local BezierModule = require(modules.BezierCurve)
local VFXHelp = require(effectModules.VFXHelp)
local RockModule = require(effectModules.RockModule)
local StopwatchCreator = require(modules.StopwatchCreator)
local CustomWait = require(modules.CustomWait)
local AnimHelper = require(modules.AnimationHelper)
local Utility = require(modules.Utility)

local SharedModules = {}
for i,v in pairs(effectModules:GetChildren()) do
	if v:IsA('ModuleScript') and v.Name~= script.Name then
		SharedModules[v.Name] = require(v)
	end
end

local Sprites = {
	Core = {
		"rbxassetid://13326064330",
		"rbxassetid://13326080177",
		"rbxassetid://13326082358",
		"rbxassetid://13326086506",
		"rbxassetid://13326088142",
		"rbxassetid://13326089464",
		"rbxassetid://13326091182",
		"rbxassetid://13326092804",
		"rbxassetid://13326094064",
	},

	Contrast = {
		"rbxassetid://13326234621",
		"rbxassetid://13326235575",
		"rbxassetid://13326236929",
		"rbxassetid://13326238261",
		"rbxassetid://13326240074",
		"rbxassetid://13326241442",
		"rbxassetid://13326242651",
		"rbxassetid://13326243980",
		"rbxassetid://13326245093",
		"rbxassetid://13326246326",
		"rbxassetid://13326247910",
		"rbxassetid://13326249113",
		"rbxassetid://13326250240",
		"rbxassetid://13326251470"
	}
}

local Rng = math.random
local rad = math.rad
local angle = CFrame.fromEulerAnglesXYZ

return function( Data )
	local Root:Part = Data.root
	local Character = Data.char
	local SpearCount:number = Data.Count

	local m1fold = particles.M1

	local Flipbook = particles:FindFirstChild("Flipbook")

	local track1 = AnimHelper.GetTrack(Character.Humanoid,Animations["1"].AnimationId)
	local track2 = AnimHelper.GetTrack(Character.Humanoid,Animations["2"].AnimationId)
	local track3 = AnimHelper.GetTrack(Character.Humanoid,Animations["3"].AnimationId)
	local track4 = AnimHelper.GetTrack(Character.Humanoid,Animations["4"].AnimationId)

	local function PlaySlash(Part, rotation)
		task.spawn(function()
			local Rotation	= rotation or 0

			TweenService:Create(Part,TweenInfo.new(0.25 ,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),
				{
					["CFrame"] = Part.CFrame * CFrame.Angles(math.rad(0), math.rad(Rotation), math.rad(0));
				}
			):Play()

			TweenService:Create(Part.Light,TweenInfo.new(1 ,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),
				{
					["Range"] = 0
				}
			):Play()

			for i=1,#Flipbook:GetChildren() do
				Part.Decal.Texture = Flipbook[tostring(i)].Texture
				RunService.RenderStepped:Wait()
				if i > 10  then
					RunService.RenderStepped:Wait()
				end
			end

			Part:Destroy()

		end)

	end

	local function doSlash(rot:number,cf:CFrame,m:string)
		local function createSingleSlash(frontBoost:number)
			local slashCF = cf * CFrame.new(0,0,-frontBoost)*CFrame.Angles(0,0,math.rad(rot))*CFrame.Angles(0,math.rad(90),0)

			if m == "1" then
				local SlashMesh	= m1fold.SlashMesh:Clone()
				SlashMesh.Parent = spawnedObjects 
				SlashMesh.CFrame = slashCF * CFrame.Angles(0,math.rad(-90),0)
				PlaySlash(SlashMesh, -35)
				
				VFXHelp.EmitFromModel(SlashMesh)
			else
				VFXHelp.EmitAndRemove(m1fold.SlashParticle,slashCF)
			end
		end
		createSingleSlash(2)
	end

	local speedMultipler = 1
	local inverseMultipler = 1/speedMultipler

	local transparencyObjects:{BasePart|Decal} = {}
	for _,object:(BasePart|Decal) in Character:GetDescendants() do
		if not object:IsA("BasePart") and not object:IsA("Decal") then
			continue
		end

		table.insert(transparencyObjects,object)
	end

	local function doTeleport(moveDistance:number,easingDirection:number,teleportTime:number)
		local startCF = Root.CFrame

		local function addTransparency(transparencyAdd:number)
			for _,object in transparencyObjects do
				object.Transparency += transparencyAdd
			end
		end

		local transparencyList = {}
		if easingDirection=="In" then
			transparencyList = {
				0;
				.8;
				-.8;
				.8;
				-.8;
				.5;
				.5;
			}
		elseif easingDirection=="Out" then
			transparencyList = {
				-1;
				.8;
				-.8;
				.5;
				-.5
			}
		end

		local transparencyTimeEvents = {}
		for transparencyNum,transparency in transparencyList do
			table.insert(transparencyTimeEvents,{
				time = teleportTime/#transparencyList * (transparencyNum-1);
				func = function()
					addTransparency(transparency)
				end
			})
		end

		task.spawn(CustomWait.RunTimeEvents,transparencyTimeEvents)

		task.spawn(function()
			StopwatchCreator.newTimer(teleportTime*inverseMultipler,function(alpha:number,timePassed:number)
				alpha = TweenService:GetValue(alpha,Enum.EasingStyle.Quad,Enum.EasingDirection[easingDirection])

				local alphaMut = easingDirection=="Out" and 1-alpha or alpha
				local sideDist = math.sin(timePassed*(25*inverseMultipler))*8*alphaMut

				Root.CFrame = Root.CFrame:Lerp( startCF * CFrame.new(0,0,-(moveDistance*alpha)),.2)
			end)
		end)
	end
	
	local function move(ring)
		local c = ring:Clone()
		c.CFrame = ring.CFrame
		c.CastShadow = false
		c.Parent = spawnedObjects
		c.Transparency = 0
		c.Size = Vector3.zero

		local c2 = ring:Clone()
		c2.CFrame = ring.CFrame
		c2.CastShadow = false
		c2.Parent = spawnedObjects
		c2.Material = Enum.Material.Neon
		c2.Size = Vector3.zero
		c2.Color = Color3.fromRGB(255, 255, 255)		
		
		TweenService:Create(c2, TweenInfo.new(.2), {Color = Color3.fromRGB(145, 13, 188)}):Play()
		TweenService:Create(c, TweenInfo.new(.3), {Size = Vector3.new(0.51, 0.949, 2.2)}):Play()
		TweenService:Create(c2, TweenInfo.new(.1), {Size = Vector3.new(0.5, 0.949, 2.3)}):Play()

		if ring:GetAttribute("rotationa") == 1 then

			ring:SetAttribute("rotationa", 2)
			c.CFrame *= CFrame.Angles(0, 0, math.rad(90))
			c2.CFrame *= CFrame.Angles(0, 0, math.rad(90))

		else

			ring:SetAttribute("rotationa", 1)

		end
		task.delay(1.5,function()
			TweenService:Create(c2, TweenInfo.new(.3), {Size = Vector3.zero}):Play()
			TweenService:Create(c, TweenInfo.new(.3), {Size = Vector3.zero}):Play()
			Debris:AddItem(c,.3)
			Debris:AddItem(c2,.3)
		end)
	end
	
	local function shockimpact(part:Part)
		VFXHelp.EmitAndRemove(particles.impact,part.CFrame,{maxFloorDist = 10})
	end
	sound.Yinlin.slash1:Play()
	track1:Play()
	
	local effect = Utility.Clone(m1fold.m1, spawnedObjects, Root.CFrame * CFrame.new(0,2,0))
	Utility.Emit(effect)
	Utility.DelayDestruction(1.3, effect)
	
	for i = 1,SpearCount do
		sound.Yinlin.back:Play()
		
		local shard = particles.shard:Clone()
		shard.CFrame = Root.CFrame * CFrame.new(0,-5,0)
		shard.Parent = spawnedObjects

		BezierModule.CubicCurve2(
			shard,
			(Root.CFrame * CFrame.new(math.random(-35,35),math.random(25,35),math.random(-35,35))).Position,
			(Root.CFrame * CFrame.new(0,0,-10) * CFrame.new(math.random(-3,3),-3,math.random(-3,3))).Position,
			0.08,
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			true,
			move,
			true,
			shockimpact
		)
	end
	
	wait(0.6)
	track2:Play()
	
	local effect = Utility.Clone(m1fold.m2, spawnedObjects, Root.CFrame * CFrame.new(0,2,0))
	Utility.Emit(effect)
	Utility.DelayDestruction(1.3, effect)
	
	for i = 1,SpearCount do
		sound.Yinlin.back:Play()
		
		local shard = particles.shard:Clone()
		shard.CFrame = Root.CFrame * CFrame.new(0,-5,0)
		shard.Parent = spawnedObjects

		BezierModule.CubicCurve2(
			shard,
			(Root.CFrame * CFrame.new(math.random(-35,35),math.random(25,35),math.random(-35,35))).Position,
			(Root.CFrame * CFrame.new(0,0,-10) * CFrame.new(math.random(-3,3),-3,math.random(-3,3))).Position,
			0.08,
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			true,
			move,
			true,
			shockimpact
		)
	end
	
	wait(0.1)
	doSlash(-130,Root.CFrame * CFrame.new(0,3,0))
	
	local spcf = Root.CFrame * CFrame.new(0,-2,-10)
	
	for i = 1,SpearCount do
		sound.Yinlin.back:Play()

		local shard = particles.shard:Clone()
		shard.CFrame = Root.CFrame * CFrame.new(0,-5,0)
		shard.Parent = spawnedObjects

		BezierModule.CubicCurve2(
			shard,
			(Root.CFrame * CFrame.new(math.random(-35,35),math.random(25,35),math.random(-35,35))).Position,
			(Root.CFrame * CFrame.new(0,0,-10) * CFrame.new(math.random(-3,3),-3,math.random(-3,3))).Position,
			0.08,
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			true,
			move,
			true,
			shockimpact
		)
	end
	
	doTeleport(-25,"Out",1)
	
	sound.Yinlin.backup:Play()

	wait(0.7)
	Root.Transparency = 1
	track3:Play()
	
	for i = 1,SpearCount do
		sound.Yinlin.back:Play()

		local shard = particles.shard:Clone()
		shard.CFrame = Root.CFrame * CFrame.new(0,-5,0)
		shard.Parent = spawnedObjects

		BezierModule.CubicCurve2(
			shard,
			(spcf * CFrame.new(math.random(-35,35),math.random(25,35),math.random(-35,35))).Position,
			(spcf * CFrame.new(0,0,-10) * CFrame.new(math.random(-3,3),-3,math.random(-3,3))).Position,
			0.08,
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			true,
			move,
			true,
			shockimpact
		)
	end
	
	task.spawn(function()
		local sp = false

		local spin = m1fold.SpinSlash:Clone()
		spin.CFrame = spcf
		spin.Parent = spawnedObjects

		TweenService:Create(spin, TweenInfo.new(.7), {CFrame = spin.CFrame * CFrame.new(0,12,0)}):Play()
		sp = true
		task.spawn(function()
			while sp == true do
				spin.CFrame = spin.CFrame * CFrame.Angles(0,math.rad(math.random(-180,180)),math.rad(math.random(-10,10)))
				doSlash(0,spin.CFrame)
				local effect = Utility.Clone(m1fold.m1, spawnedObjects, spin.CFrame)
				Utility.Emit(effect)
				Utility.DelayDestruction(1.3, effect)
				
				
				wait(0.05)
			end
		end)
		wait(.7)
		VFXHelp.DisableVFX(spin)
		sp = false
		Debris:AddItem(spin,1)
	end)
	wait(.5)
	track4:Play()
	
	sound.Yinlin.slash2:Play()
	
	doSlash(-35,Root.CFrame * CFrame.new(0,0,-10),"1")

	doSlash(215,Root.CFrame * CFrame.new(0,0,-10),"1")
	
	wait(0.5)
	local fx = VFXHelp.EmitAndRemove(particles.Slam,Root.CFrame * CFrame.new(0,0,-30),{maxFloorDist = 10})

	local xmark = particles.Xmark:Clone()
	xmark.Parent = spawnedObjects
	xmark.CFrame = fx.CFrame
	
	VFXHelp.EmitFromModel(xmark)
	
	task.spawn(function()
		wait(2)
		for i ,v in ipairs(xmark:GetDescendants()) do
			if v:IsA("Beam") then
				TweenService:Create(v, TweenInfo.new(.5), {Width0 = 0,Width1 = 0}):Play()
			end
		end
	end)
	
	Debris:AddItem(xmark,3)
	
	SharedModules['Gust'].GroundWind({xn = 3, cf = fx.CFrame, tim = 0.5, colr = BrickColor.new("White") })  
	local ring = mesheffects.inversRing:Clone()
	ring.Parent = spawnedObjects
	ring.CFrame = fx.CFrame
	SharedModules['TM'].Clasic_tween(ring , {size = Vector3.new(35,0,35),startSize = Vector3.new(1,70,1) , sizeTim = 0.5/1.5,tim = 0.5 ,EasingStyle = Enum.EasingStyle.Exponential,EasingDirection = Enum.EasingDirection.Out,trans = 1,transTim = 0.5  ,startTrans = .5,	})
	ring.Material = Enum.Material.Neon
	game.Debris:AddItem(ring, 0.5 * 1.5)


	task.spawn(function()
		local Loop = Rng(1,5)
		local Rotate = 0
		local CalAngle = 360/Loop

		local Param = RaycastParams.new()
		Param.FilterDescendantsInstances = {Character,workspace.Terrain}
		Param.FilterType = Enum.RaycastFilterType.Exclude

		for i = 1,15 do
			local Rock = particles.Pebble:Clone()
			Rock.Size = Vector3.new(Rng(1,3),Rng(1,3),Rng(1,3))
			Rock.CFrame = fx.CFrame * CFrame.new(0,3,0) * angle(rad(Rng(-17,17)),0,rad(Rng(-17,17))) * CFrame.new(Rng(-15,15),0,Rng(-15,15))
			Rock.Anchored = true

			local RayCast = workspace:Raycast(Rock.CFrame.Position,Rock.CFrame.UpVector * -50,Param)
			if RayCast then
				local HitPart = RayCast.Instance
				Rock.Anchored = false
				Rock.Position = RayCast.Position - Vector3.new(0,1,0)
				Rock.Parent = spawnedObjects
				Rock.Color = HitPart.Color
				Rock.Material = HitPart.Material
				Rock.CanCollide = false
				for _,A in pairs(HitPart:GetChildren()) do
					if A:IsA("Texture") then
						local Clone = A:Clone()
						Clone.Parent = Rock
					end
				end
				local Linear = Instance.new("LinearVelocity",Rock)
				Linear.Attachment0 = Rock["Liner"]
				Linear.MaxForce = 1*80000
				Linear.VectorVelocity = Rock.CFrame.UpVector * Rng(50,100)
				task.delay(0.1,function()
					Rock.CanCollide = true
					game.Debris:AddItem(Linear,0)
					task.wait(3)
					local Goal = {
						Size = Vector3.new(0,0,0),
					}
					local Info = TweenInfo.new(1,Enum.EasingStyle.Sine)
					local Tween = TweenService:Create(Rock,Info,Goal)
					Tween:Play()
					Tween.Completed:Connect(function()
						game.Debris:AddItem(Rock,0)
					end)
				end)
			end
		end
	end)
	
	
	for i = 1,SpearCount do
		sound.Yinlin.back:Play()

		local shard = particles.shard:Clone()
		shard.CFrame = Root.CFrame * CFrame.new(0,-5,0)
		shard.Parent = spawnedObjects

		BezierModule.CubicCurve2(
			shard,
			(Root.CFrame * CFrame.new(math.random(-35,35),math.random(25,35),math.random(-35,35))).Position,
			(Root.CFrame * CFrame.new(0,0,-20) * CFrame.new(math.random(-3,3),-3,math.random(-3,3))).Position,
			0.08,
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			Vector3.new(0,0,0),
			true,
			move,
			true,
			shockimpact
		)
	end
	
	Root.Anchored = false
end

