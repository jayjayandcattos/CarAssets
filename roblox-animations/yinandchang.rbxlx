							<string name="ScriptGuid">{bcae1cdc-988a-4c32-93df-65d91ad40812}</string>
							<ProtectedString name="Source"><![CDATA[-- Localization
local Random = Random.new()

local Parent = workspace.SpawnedObjects

-- Services
local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')
local Debris = game:GetService('Debris')

-- Player
local Player = Players.LocalPlayer

-- Properties
local Range = Vector3.new(0, -20, 0)

return function(Origin: CFrame, Data: table)
	
	local Parts = { }
	
	-- Properties
	local Radius = Data and Data.Radius or 32.5
	local Size = Data and Data.Size or Vector3.new(7, 2, 7)
	local PartCount =Data and  Data.PartCount or 15
	local Duration = Data and Data.Duration or 1
	local Filter = Data and Data.Filter or { Parent, Player.Character }	
	
	-- Angles
	local Angle = 30
	local OtherAngle = 360 / PartCount
	
	-- Raycast Data
	local RaycastData = RaycastParams.new()
	RaycastData.FilterType = Enum.RaycastFilterType.Exclude
	RaycastData.FilterDescendantsInstances = Filter
	
	-- Main function for rocks
	for _ = 1, PartCount do
		local Time = Random:NextNumber(1, 2)
		local Info = TweenInfo.new(Time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		
		local CF = Origin
		local NewCFOuter = CF * CFrame.fromEulerAnglesXYZ(0, math.rad(Angle), 0) * CFrame.new(Radius / 2 + Radius / 4, 10, 0)

		local OuterRaycast = workspace:Raycast(NewCFOuter.Position, Range, RaycastData)
		
		if OuterRaycast then
			local Part = Instance.new('Part')
			Part.Anchored, Part.CanCollide, Part.CanTouch, Part.CanQuery = true, false, false, false
			Part.Material = Enum.Material.Slate
			Part.Color = OuterRaycast.Instance.Color
			Part.CFrame = CFrame.lookAt(OuterRaycast.Position - Vector3.new(0, 0, math.random(-5, 20)), Origin.Position) * CFrame.fromEulerAnglesXYZ(Random:NextNumber(-0.25, 0.5), Random:NextNumber(-0.25, 0.25), Random:NextNumber(-0.25, 0.25))
			Part.CFrame = CFrame.lookAt(Part.Position, Origin.Position - Vector3.new(0, 5, 0))
			Part.Size = Vector3.new(Size.X * 1.3, Size.Y / 1.4, Size.Z * 1.3) * Random:NextNumber(1, 1.5)
			Part.Parent = Parent
			
			for _, Texture in ipairs(OuterRaycast.Instance:GetChildren()) do
				if Texture:IsA('Texture') then
					Texture:Clone().Parent = Part
				end
			end
			
			table.insert(Parts, Part)
			
			task.delay(Duration, function()
				for _, Rock in ipairs(Parts) do
					TweenService:Create(Rock, Info, {Position = Rock.CFrame.Position - Vector3.new(0, (Size.Y * 2), 0)}):Play()
					Debris:AddItem(Rock, 3)
					task.wait(0.03)
				end
			end)
		end
		Angle += OtherAngle
	end
end]]></ProtectedString>
