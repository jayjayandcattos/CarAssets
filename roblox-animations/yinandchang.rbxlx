							<ProtectedString name="Source"><![CDATA[--// Service
local rp = game:GetService('ReplicatedStorage')
local RS = game:GetService('RunService')
local TS = game:GetService('TweenService')

--// Module(s)
local SharedModules = {}
for i,v in pairs(rp.Modules.FXModules.Effects:GetChildren()) do
	if v:IsA('ModuleScript') and v.Name~= script.Name then
		SharedModules[v.Name] = require(v)
	end
end

--// Utilities
local module = {}

--// GroundWind
module.GroundWind = function(Data)
	local part = Data.part 
	local ttab =Data.ttab or {.5,.4,.3}
	local xn = Data.xn or  4.4/2
	local spd = Data.speed
	local forlop = Data.forlop or 1
	local wait_= Data.wait_ 
	local gtab = Data.gtab or {true, false, false,false}
	local cf = Data.cf -- hroot.CFrame * CFrame.new(0,-2.5,0) --* CFrame.Angles(math.rad(0),0,math.rad(45))
	local _CF = cf
	local timCrun = Data.timCrun or 1
	
	local colr = Data.colr 
	task.spawn(function()
	
		for i = 1, forlop do
			local tim = Data.tim or  ttab[math.random(1,#ttab)]
			local glass = Data.glass or  gtab[math.random(1,#gtab)]
			-- CurveWind
			tim = tim * timCrun
			cf = _CF
			if cf then cf = cf * CFrame.Angles(math.rad(math.random(-25,25)),0,0) else cf = part.CFrame * CFrame.new(0,-2.5,0) * CFrame.Angles(math.rad(math.random(-25,25)),0,0)  end
			local Wind = script.VFX["CurveWind"]:Clone()
			Wind.Parent = workspace.SpawnedObjects
			Wind.CFrame = cf
			if colr then Wind.BrickColor = colr end
			SharedModules['TM'].Clasic_tween(Wind, {startSize = Vector3.new(0,5*xn,0),size = Vector3.new(25*xn, 5*xn, 25*xn),  tim = tim, startTrans = .5,trans = 1,  EasingStyle = Enum.EasingStyle.Sine, EasingDirection = Enum.EasingDirection.Out})
			SharedModules['Spin'].Spin({part = Wind, angleY = 360, tim = tim, speed = spd or math.random(.3/2, 3/2)})
			game.Debris:AddItem(Wind, tim)

			--growing wind
			cf = _CF
			if cf then cf = cf  else cf = part.CFrame * CFrame.new(0,-2.5,0)  end
			local Wind = script.VFX["growing wind"]:Clone()
			Wind.Parent = workspace.SpawnedObjects
			Wind.CFrame = cf
			if colr then Wind.BrickColor = colr end
			if glass == true then Wind.Material = Enum.Material.Glass end
			SharedModules['TM'].Clasic_tween(Wind, {startSize = Vector3.new(1*xn,5*xn,1*xn),size = Vector3.new(16*xn, 3.5*xn, 16*xn),  tim = tim, startTrans = 0,trans = 1,  EasingStyle = Enum.EasingStyle.Sine, EasingDirection = Enum.EasingDirection.Out})
			SharedModules['Spin'].Spin({part = Wind, angleY = 360, tim = tim, speed = spd or math.random(.3/2, 3/2)})
			game.Debris:AddItem(Wind, tim)

			-- CurveWind
			cf = _CF
			if cf then cf = cf * CFrame.Angles(math.rad(math.random(-25,25)),0,0) else cf = part.CFrame * CFrame.new(0,-2.5,0) * CFrame.Angles(math.rad(math.random(-25,25)),0,0)  end
			local Wind = script.VFX["CurveWind"]:Clone()
			Wind.Parent = workspace.SpawnedObjects
			Wind.CFrame = cf
			if colr then Wind.BrickColor = colr end
			SharedModules['TM'].Clasic_tween(Wind, {startSize = Vector3.new(0,5*xn,0),size = Vector3.new(25*xn, 5*xn, 25*xn),  tim = tim, startTrans = .5,trans = 1,  EasingStyle = Enum.EasingStyle.Sine, EasingDirection = Enum.EasingDirection.Out})
			SharedModules['Spin'].Spin({part = Wind, angleY = 360, tim = tim, speed = spd or math.random(.3/2, 3/2)})
			game.Debris:AddItem(Wind, tim)

			
			if Data.wait_ then
				task.wait(wait_ or tim/2)
			end
			
		end
	end)
end
